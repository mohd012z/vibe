# Copy to /etc/vibebot/vibebot.env and chmod 600.
# Never commit the real token.
VIBE_TELEGRAM_TOKEN=replace_with_bot_token
# Comma-separated numeric Telegram user/chat IDs allowed to operate VibeBot.
VIBE_BOT_ALLOWED_USERS=123456789
# Optional file-root restriction for path-based advanced commands.
VIBE_FILE_ROOT=/var/lib/vibebot/work
